# Copy to .env for `netlify dev`. Never commit the real .env.
ACCESS_TOKEN=generate-with-npm-run-token

# Providers: set at least one. A provider shows up only when its key is set.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
# Cloudflare Workers AI needs both of these.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
COHERE_API_KEY=
NVIDIA_API_KEY=

# Optional model overrides (defaults shown)
# GEMINI_MODEL=gemini-3.5-flash-lite
# GROQ_MODEL=openai/gpt-oss-120b
# OPENROUTER_MODEL=openrouter/free
# MISTRAL_MODEL=mistral-small-latest
# CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# COHERE_MODEL=command-a-plus-05-2026
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# SYSTEM_PROMPT=You are a helpful assistant.
